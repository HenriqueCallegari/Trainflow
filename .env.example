# Copie este arquivo para .env e preencha com seus valores.
# Em desenvolvimento local os padrões embutidos no settings.py já funcionam.

# Django
DJANGO_SECRET_KEY=change-me-generate-with-django-utils-crypto-get_random_secret_key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — opção 1: URL completa (recomendado no Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# PostgreSQL — opção 2: variáveis separadas (fallback se DATABASE_URL não estiver definida)
# POSTGRES_DB=trainflow
# POSTGRES_USER=trainflow
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email SMTP — opcional; sem isso os emails saem no console
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
